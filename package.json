{
  "name": "dsh-ronaldo-pet",
  "version": "2.0.0",
  "private": false,
  "description": "DSH 桌宠 bundle 插件（v2）。住在 Web 界面右下角的精灵宠物 + 一个独立于浏览器的原生桌面窗口：随 Agent 工作状态切换动作（对话中专注工作、回合思考、等待审批、出错摔倒），对话完成时跳跃庆祝并全机播放提示音。原生桌面窗口最小化/关闭网页也照样存在，悬停显示当前工作区与对话名，双击用 Edge 打开 Harness 网页。内置多宠物注册表（跨重启保留）、每宠物独立音频、素材 HTTP 路由与注册即校验（严格防图片错位）。配套技能 dsh-pet-forge 可一句话生成并导入新宠物（生图模型 + Blender 3D 建模 + 动作/音效设计）。",
  "type": "module",
  "main": "host.js",
  "license": "MIT",
  "author": "Stellum-Waq",
  "homepage": "https://github.com/Stellum-Waq/dsh-pet-ronaldo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stellum-Waq/dsh-pet-ronaldo.git"
  },
  "bugs": {
    "url": "https://github.com/Stellum-Waq/dsh-pet-ronaldo/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "bundle",
    "desktop-pet",
    "pet",
    "desktop",
    "ronaldo",
    "cr7",
    "web-ui",
    "cordis"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./host.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "host.js",
    "client",
    "cordis.patch.yml",
    "assets",
    "desktop",
    "skill",
    "scripts",
    "docs",
    "demo",
    "CHANGELOG.md"
  ]
}
