    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "host.js",
    "client",
    "cordis.patch.yml",
    "assets",
    "scripts",
    "docs",
    "demo"
  ]
